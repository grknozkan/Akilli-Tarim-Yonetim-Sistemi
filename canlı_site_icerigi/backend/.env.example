# ================================================
# ATYS Backend - Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp .env olarak kaydedin:
#   cp .env.example .env
# ================================================

# ----- SUNUCU -----
NODE_ENV=development
PORT=5000

# ----- VERİTABANI (PostgreSQL / Neon.tech) -----
# Neon.tech dashboard'undan aldığınız bağlantı URL'si
DATABASE_URL=postgresql://kullanici:sifre@host/veritabani?sslmode=require

# ----- JWT KİMLİK DOĞRULAMA -----
# Güvenli, rastgele bir string (en az 32 karakter önerilir)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=buraya_guclu_bir_secret_yazin
JWT_EXPIRES_IN=7d

# ----- CORS -----
# Frontend URL'si (virgülle ayırarak birden fazla eklenebilir)
ALLOWED_ORIGINS=http://localhost:5173,https://atys-app.vercel.app

# ----- RATE LIMITING -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- LOG SEVİYESİ -----
# debug | info | warn | error
LOG_LEVEL=debug

# ----- HAVA DURUMU API (Opsiyonel) -----
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
